{
  "realm": "cargoservice",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "Client", "description": "Клиент — отправитель/получатель груза" },
      { "name": "Manager", "description": "Менеджер back-office" },
      { "name": "WarehouseOperator", "description": "Приёмка/обработка груза на складе" },
      { "name": "Courier", "description": "Курьер (забор/доставка)" },
      { "name": "Admin", "description": "Администратор системы" },
      { "name": "FileWriter", "description": "Может заводить файлы в хранилище. Роль для сервисных учётных записей: файлы создают не только сотрудники — document-service кладёт туда сформированные PDF" }
    ]
  },
  "clients": [
    {
      "clientId": "identity-service",
      "name": "identity-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "identity-service-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "document-service",
      "name": "document-service (service account)",
      "description": "Межсервисные вызовы document-service → file-storage-service (загрузка сформированных PDF). Только client_credentials; сервисной учётной записи выдана роль FileWriter.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "document-service-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ai-inspection-service",
      "name": "ai-inspection-service (service account)",
      "description": "Межсервисные вызовы ai-inspection-service → file-storage-service (скачивание фото на инференс). Только client_credentials.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ai-inspection-service-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cargo-service",
      "name": "cargo-service (service account)",
      "description": "Межсервисные вызовы cargo-service → file-storage-service. Только client_credentials: пользовательских потоков нет, поэтому standardFlow и directAccessGrants выключены.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "cargo-service-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-identity-service",
      "enabled": true,
      "serviceAccountClientId": "identity-service",
      "clientRoles": {
        "realm-management": ["manage-users", "view-realm"]
      }
    },
    {
      "username": "service-account-document-service",
      "enabled": true,
      "serviceAccountClientId": "document-service",
      "realmRoles": ["FileWriter"]
    },
    {
      "username": "admin@cargoservice.local",
      "email": "admin@cargoservice.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Administrator",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["Admin"]
    }
  ]
}
